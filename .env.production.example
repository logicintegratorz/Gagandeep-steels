APP_NAME="Gagandeep Steels"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://crm.example.com
APP_TIMEZONE=Asia/Kolkata

LOG_CHANNEL=single
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=your-postgresql-host
DB_PORT=5432
DB_DATABASE=gagandeep_steels
DB_USERNAME=gagandeep_crm
DB_PASSWORD=use-a-strong-secret
DB_SSLMODE=require

SESSION_DRIVER=file
SESSION_LIFETIME=30
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
CACHE_STORE=file
QUEUE_CONNECTION=sync

MAIL_MAILER=smtp
MAIL_HOST=your-smtp-host
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=crm@example.com
MAIL_FROM_NAME="Gagandeep Steels"

CRM_SMS_API_URL=
CRM_SMS_API_TOKEN=
CRM_SMS_SENDER=
CRM_CALL_API_URL=
CRM_CALL_API_TOKEN=
CRM_CALLER_ID=
