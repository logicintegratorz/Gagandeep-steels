APP_NAME="Gagandeep Steels"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Kolkata
LOG_CHANNEL=single
LOG_LEVEL=debug
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=hauldesk
DB_USERNAME=postgres
DB_PASSWORD=
DB_SSLMODE=require
SESSION_DRIVER=file
SESSION_LIFETIME=30
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
CACHE_STORE=file
QUEUE_CONNECTION=sync


# Use smtp and real credentials for delivered password-reset emails.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=crm@example.com
MAIL_FROM_NAME="Gagandeep Steels"

# Optional provider adapters. Existing tel:/sms:/mailto:/wa.me fallbacks remain
# active when these are blank. Endpoints receive JSON over HTTPS with a Bearer token.
CRM_SMS_API_URL=
CRM_SMS_API_TOKEN=
CRM_SMS_SENDER=
CRM_CALL_API_URL=
CRM_CALL_API_TOKEN=
CRM_CALLER_ID=

